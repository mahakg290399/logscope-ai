# LogScope AI - Local Environment Variables
# Copy to .env and customize

# Application Environment
LOGSCOPE_ENV=development
LOGSCOPE_PORT=8000
LOGSCOPE_HOST=127.0.0.1
LOGSCOPE_DB_PATH=./data/logscope.db
LOGSCOPE_DATA_DIR=./data

# Kafka Configuration
LOGSCOPE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
LOGSCOPE_KAFKA_CLIENT_ID=logscope-local
LOGSCOPE_KAFKA_TOPIC_OBSERVATIONS=logscope.template-observations
LOGSCOPE_KAFKA_TOPIC_ANOMALIES=logscope.anomaly-jobs
LOGSCOPE_KAFKA_TOPIC_ANALYSES=logscope.analysis-results
# Set to true only in tests or direct local development. Docker POC requires Kafka.
LOGSCOPE_KAFKA_EMBEDDED_FALLBACK=false

# AI Provider Configuration: nvidia | openai | gemini | omniroute | auto
LOGSCOPE_AI_PROVIDER=nvidia

# NVIDIA NIM Configuration (Microservice or Hosted API)
NVIDIA_API_KEY=replace-with-your-nvapi-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v1

# OpenAI Configuration (Optional / Fallback)
OPENAI_API_KEY=replace-with-a-rotated-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini Configuration (Optional / Fallback)
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_MODEL=gemini-2.0-flash

LOGSCOPE_AI_BATCH_INTERVAL_SECONDS=60
LOGSCOPE_AI_MAX_BATCH_SIZE=10

# Retention Policies
LOGSCOPE_SAMPLE_RETENTION_HOURS=24
LOGSCOPE_AGGREGATE_RETENTION_MONTHS=6

# Anomaly Thresholds
LOGSCOPE_SPIKE_ZSCORE_THRESHOLD=3.0
LOGSCOPE_MIN_SAMPLE_COUNT_FOR_SPIKE=5
