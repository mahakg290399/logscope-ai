#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - docker.io
  - docker-compose-v2
  - git
  - python3-venv
  - sudo

users:
  - default
  - name: ${deploy_user}
    shell: /bin/bash
    groups: docker
    lock_passwd: true

write_files:
  - path: /etc/logscope/oci-secrets.conf
    owner: root:root
    permissions: '0600'
    content: |
      OCI_REGION=${region}
      LOGSCOPE_DOMAIN=${logscope_domain}
      OPENAI_SECRET_OCID=${openai_secret_ocid}
      GEMINI_SECRET_OCID=${gemini_secret_ocid}
      NVIDIA_SECRET_OCID=${nvidia_secret_ocid}
  - path: /etc/sudoers.d/logscope-deploy
    owner: root:root
    permissions: '0440'
    content: |
      ${deploy_user} ALL=(root) NOPASSWD: /opt/logscope/deploy/oracle/bootstrap-secrets.sh
  - path: /home/${deploy_user}/.ssh/authorized_keys
    permissions: '0600'
    content: |
      ${ssh_public_key}

runcmd:
  - systemctl enable --now docker
  - install -d -m 0700 -o ${deploy_user} -g ${deploy_user} /home/${deploy_user}/.ssh
  - chown ${deploy_user}:${deploy_user} /home/${deploy_user}/.ssh/authorized_keys
  - git clone ${repository_url} /opt/logscope
  - chown -R ${deploy_user}:${deploy_user} /opt/logscope
  - python3 -m venv /opt/oci-cli
  - /opt/oci-cli/bin/pip install --quiet --upgrade pip oci-cli
  - ln -sf /opt/oci-cli/bin/oci /usr/local/bin/oci
  - chmod 0755 /opt/logscope/deploy/oracle/bootstrap-secrets.sh
  - systemctl restart ssh
